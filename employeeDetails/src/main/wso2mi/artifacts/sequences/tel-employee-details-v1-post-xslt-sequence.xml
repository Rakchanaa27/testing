<?xml version="1.0" encoding="UTF-8"?>
 
<sequence name="CustomerXSLTSequence"
          xmlns="http://ws.apache.org/ns/synapse">
 
    <log level="custom">
        <property name="TRANSFORMATION"
                  value="Customer XSLT Transformation Started"/>
    </log>
 
    <xslt key="conf:/xslt/tel-employee-details-v1-xslt.xslt"/>
 
    <property name="messageType"
              value="application/xml"
              scope="axis2"
              type="STRING"/>
 
    <property name="ContentType"
              value="application/xml"
              scope="axis2"
              type="STRING"/>
 
    <log level="full">
        <property name="TRANSFORMATION"
                  value="Customer XSLT Transformation Completed"/>
    </log>
 
    <respond/>
 
</sequence>